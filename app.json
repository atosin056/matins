{
  "expo": {
    "name": "matins",
    "slug": "matins",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "matins",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Matins to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow Matins to use the microphone for voice search."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F5D50",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.matins"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F5D50"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Matins to use the microphone for voice search.",
          "speechRecognitionPermission": "Allow Matins to use speech recognition.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "98c06445-6a69-4325-bef0-ef8dab96c39e"
      }
    }
  }
}
